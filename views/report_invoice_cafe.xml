<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- isfehka_cafe/views/report_invoice_cafe.xml -->

    <!-- Inherit main invoice document — CAFE Formato 1 (Papel Carta) per DGI spec -->
    <template id="report_invoice_cafe"
              inherit_id="account.report_invoice_document">

      <!-- ============================================================
           CAFE HEADER — placed at the top, before partner addresses
           ============================================================ -->
      <xpath expr="//t[@t-set='forced_vat']" position="after">
        <div t-if="o.hka_cufe" style="font-size:10px;">

          <!-- DGI Title Block -->
          <div class="text-center mb-2">
            <div style="font-size:14px; font-weight:bold;">DGI</div>
            <div style="font-size:11px; font-weight:bold;">Comprobante Auxiliar de Factura Electrónica</div>
            <div style="font-size:11px; font-weight:bold;">
              <span t-field="o.tipo_documento"/>
            </div>
          </div>

          <!-- Document Details + QR Code Row -->
          <div class="row mb-2" style="font-size:10px;">
            <div class="col-8">
              <table style="font-size:10px; line-height:1.6;">
                <tr>
                  <td style="padding-right:30px;">Tipo: <span t-field="o.tipo_documento"/></td>
                  <td>Número: <t t-esc="o.numero_documento_fiscal"/></td>
                </tr>
                <tr>
                  <td colspan="2" style="word-break:break-all; font-family:monospace; font-size:9px; padding-top:2px;">
                    CUFE: <t t-esc="o.hka_cufe"/>
                  </td>
                </tr>
                <tr>
                  <td style="padding-right:30px;">Fecha: <span t-field="o.invoice_date"/></td>
                  <td>Hora: <span t-if="o.hka_fecha_recepcion_dgi" t-field="o.hka_fecha_recepcion_dgi" t-options='{"widget": "datetime", "format": "HH:mm:ss"}'/></td>
                </tr>
              </table>

              <!-- Authorization -->
              <div class="mt-2" t-if="o.hka_nro_protocolo_autorizacion">
                Autorización DGI: <t t-esc="o.hka_nro_protocolo_autorizacion"/>
                de <span t-field="o.hka_fecha_recepcion_dgi" t-options='{"widget": "datetime"}'/>
              </div>

              <!-- CUFE Consultation -->
              <div class="mt-1">
                Consulte en https://dgi-fep.mef.gob.pa/Consultas/FacturasPorCUFE usando el CUFE:
              </div>
              <div style="word-break:break-all; font-family:monospace; font-size:9px;">
                <t t-esc="o.hka_cufe"/>
              </div>
              <div class="mt-1">o escaneando el código QR</div>

              <!-- Branch / POS -->
              <div class="mt-2">
                Sucursal: <t t-esc="o._get_hka_branch()"/> – Pto Fact: <t t-esc="o._get_hka_pos_code()"/>
              </div>
            </div>

            <!-- QR Code (right column) -->
            <div class="col-4 text-center pt-2">
              <img t-if="o.hka_cufe_qr_image"
                   t-att-src="image_data_uri(o.hka_cufe_qr_image)"
                   style="width:130px; height:130px;"/>
            </div>
          </div>

          <hr style="margin:4px 0 12px 0;"/>
        </div>
      </xpath>

      <!-- ============================================================
           PAC FOOTER — at the bottom of the page
           ============================================================ -->
      <xpath expr="//div[hasclass('page')]" position="inside">
        <div t-if="o.hka_cufe" class="text-center mt-4 pt-2" style="font-size:8px; border-top:1px solid #ccc; color:#555;">
          Documento validado por The Factory HKA Corp. con RUC 155596713-2-2015,
          es Proveedor Autorizado Calificado, Resolución No. 201-9719 de 12/10/2021
        </div>
      </xpath>

    </template>
</odoo>